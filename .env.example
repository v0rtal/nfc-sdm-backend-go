# Generate NFC and management secrets separately: go run . keygen
MASTER_KEY=
ADMIN_TOKEN=
DERIVE_MODE=legacy
LISTEN_ADDR=127.0.0.1:5000
DATABASE_URL=postgres://nfctag:REPLACE_WITH_RANDOM_HEX_PASSWORD@127.0.0.1:5432/nfctag?sslmode=disable
# docker compose uses this variable; prefer a generated hex password.
POSTGRES_PASSWORD=
# Optional TLS listener; both TLS paths must be supplied when HTTPS_ADDR is set.
HTTPS_ADDR=
TLS_CERT=
TLS_KEY=
# Enable only when the origin receives connections directly from Cloudflare.
CLOUDFLARE_PROXY=0
TRUSTED_PROXY_CIDRS=
# Optional external approximate-IP lookup. Sends the client IP to ipwho.is.
IP_GEOLOCATION=0
APK_PATH=dist/NFC-Tag-Writer-debug.apk
